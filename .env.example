# Shared runtime PostgreSQL. Keep DATABASE_URL only in .env, never .env.local.
DATABASE_URL="postgresql://runtime_user:replace_me@db.example.invalid:5432/aquaops?sslmode=require"
AQUAOPS_DATABASE_PURPOSE="shared"

# Conservative per-process pg pool defaults; tune against the provider limit.
DATABASE_POOL_MAX="3"
DATABASE_POOL_IDLE_TIMEOUT_MS="10000"
DATABASE_POOL_CONNECTION_TIMEOUT_MS="10000"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
AQUAOPS_AUTH_BYPASS="false"

# One-time initial Owner bootstrap. Remove these values after use.
AQUAOPS_BOOTSTRAP_EMAIL=""
AQUAOPS_BOOTSTRAP_PASSWORD=""

# Isolated disposable tests only. Never copy the shared runtime URL here.
TEST_DATABASE_URL="postgresql://test_user:replace_me@test-db.example.invalid:5432/aquaops_test_anchor?sslmode=require"
TEST_DATABASE_ADMIN_URL="postgresql://test_admin:replace_me@test-db.example.invalid:5432/postgres?sslmode=require"
AQUAOPS_DEV_SEED_PASSWORD=""

# DDL credential. For migration development, this must target an isolated migration database/branch.
MIGRATION_DATABASE_URL="postgresql://migration_user:replace_me@migration-db.example.invalid:5432/aquaops?sslmode=require"
