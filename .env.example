# PostgreSQL connection used by Prisma and Better Auth.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aquaops?schema=public"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Local UI preview only. Ignored in production even when set to true.
AQUAOPS_AUTH_BYPASS="false"

# Optional secure bootstrap. Leave blank until running the seed locally.
AQUAOPS_BOOTSTRAP_EMAIL=""
AQUAOPS_BOOTSTRAP_PASSWORD=""

# Optional fake development users only. Never enable in production.
AQUAOPS_ENABLE_DEV_SEED="false"
AQUAOPS_DEV_SEED_PASSWORD=""
