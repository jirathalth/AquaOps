    "dev": "next dev",
    "prebuild": "npm run env:check && npm run db:generate",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "pretypecheck": "npm run db:generate",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run db:generate",
    "test": "vitest run",
    "test:inventory-db": "tsx scripts/run-inventory-db-tests.mjs",
    "test:delivery-db": "tsx scripts/run-delivery-db-tests.mjs",
    "test:accounting-db": "tsx scripts/run-accounting-db-tests.mjs",
    "test:phase12-db": "tsx scripts/run-phase12-db-tests.mjs",
    "test:settings-db": "tsx scripts/run-settings-db-tests.mjs",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/run-e2e.mjs",
    "test:e2e:auth": "tsx scripts/run-auth-e2e.mjs",
    "test:e2e:delivery": "tsx scripts/run-delivery-e2e.mjs",
    "test:e2e:accounting": "tsx scripts/run-accounting-e2e.mjs",
    "test:e2e:print": "tsx scripts/run-print-e2e.mjs",
    "test:e2e:phase12": "tsx scripts/run-phase12-e2e.mjs",
    "test:e2e:settings": "tsx scripts/run-settings-e2e.mjs",
    "env:check": "tsx scripts/check-database-environment.mjs",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:validate": "prisma validate",
    "db:migrate:dev": "tsx scripts/run-prisma-migration.mjs dev",
    "db:deploy": "tsx scripts/run-prisma-migration.mjs deploy",
    "db:status": "tsx scripts/run-prisma-migration.mjs status",
    "db:bootstrap": "tsx prisma/seed.ts bootstrap",
    "db:seed": "npm run db:bootstrap",
    "db:seed:demo": "tsx prisma/seed.ts demo",
    "db:studio": "prisma studio"
